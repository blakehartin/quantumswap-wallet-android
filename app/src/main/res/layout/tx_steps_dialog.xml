<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop #modalTxSteps: title + numbered step list (badge + label
     + substatus) + wait line + transaction-id row + error line + one
     footer button that drives the current step. Controlled by
     TxStepsDialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/token_picker_dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView_tx_steps_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/colorWhite" />

        <TextView
            android:id="@+id/textView_tx_steps_dismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="×"
            android:textSize="25sp"
            android:textColor="@color/colorWhite"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/drawer_item_bg" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_tx_steps_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/textView_tx_steps_wait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textColor="#C7C1D9"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/linearLayout_tx_steps_hash_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/textView_tx_steps_hash_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorCommon3" />

        <TextView
            android:id="@+id/textView_tx_steps_hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/colorCommon6" />

    </LinearLayout>

    <TextView
        android:id="@+id/textView_tx_steps_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textColor="#DC2626"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_tx_steps_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="90dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:textAllCaps="false"
            android:textColor="@color/colorWhite"
            android:background="@drawable/button_green_selector" />

    </LinearLayout>

</LinearLayout>
