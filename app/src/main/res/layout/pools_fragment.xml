<?xml version="1.0" encoding="utf-8"?>

<!--
    Pools screen (ported from the desktop app's Pools page): browse
    all factory pairs with reserves, plus a Create-Pair form. Pool
    rows are built dynamically by PoolsFragment into
    layout_pools_list.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/top_linear_layout_pools_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@android:color/transparent">
                <ImageButton
                    android:id="@+id/imageButton_pools_back_arrow"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:layout_gravity="left"
                    android:background="@drawable/image_selector"
                    android:src="@drawable/arrow_back_circle_outline"
                    app:tint="@color/colorCommon6"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_below="@+id/top_linear_layout_pools_id"
                android:background="@drawable/center_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView_pools_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="5dp"
                        android:gravity="center"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon6" />

                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.2"
                        android:background="@drawable/line_2_shape" />

                    <!-- Desktop list panel (default view). -->
                    <LinearLayout
                        android:id="@+id/layout_pools_list_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView_pools_list_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="16dp"
                                android:textStyle="bold"
                                android:textColor="@color/colorCommon1" />

                            <ImageButton
                                android:id="@+id/imageButton_pools_refresh"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="5dp"
                                android:scaleType="fitCenter"
                                android:background="@drawable/image_selector"
                                android:src="@drawable/retry"
                                app:tint="@color/colorCommon6" />

                            <ProgressBar
                                android:id="@+id/progress_pools"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="5dp"
                                android:indeterminate="true"
                                android:indeterminateDrawable="@drawable/progress"
                                android:visibility="gone" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/textView_pools_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:textSize="13dp"
                            android:textColor="@color/colorMutedSecondaryText" />

                        <!-- Desktop .blocks-content: the table scrolls inside its
                             own box so the Create Pair link below stays on screen. -->
                        <com.quantumswap.app.view.widget.MaxHeightScrollView
                            android:id="@+id/scroll_pools_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="vertical"
                            android:fadeScrollbars="false">

                            <LinearLayout
                                android:id="@+id/layout_pools_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                        </com.quantumswap.app.view.widget.MaxHeightScrollView>

                        <!-- Desktop: "Create Pair" link below the pool list. -->
                        <TextView
                            android:id="@+id/textView_pools_create_link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp"
                            android:padding="8dp"
                            android:textSize="15dp"
                            android:textColor="@color/quantumTeal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/drawer_item_bg" />

                    </LinearLayout>

                    <!-- Desktop form panel, opened from the list. -->
                    <LinearLayout
                        android:id="@+id/layout_pools_form_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="wrap_content"
                            android:layout_height="1dp"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="10dp"
                            android:alpha="0.2"
                            android:background="@drawable/line_2_shape" />

                        <TextView
                            android:id="@+id/textView_pools_create_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="16dp"
                            android:textStyle="bold"
                            android:textColor="@color/colorCommon1" />

                        <TextView
                            android:id="@+id/textView_pools_tokenA_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="14dp"
                            android:textColor="@color/colorCommon3" />

                        <Button
                            android:id="@+id/spinner_pools_tokenA"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="40dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:gravity="start|center_vertical"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textColor="@color/colorWhite"
                            android:drawableEnd="@drawable/caret_down_outline"
                            android:background="@drawable/token_picker_trigger_bg" />

                        <EditText
                            android:id="@+id/editText_pools_tokenA_custom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="0x..."
                            android:inputType="textNoSuggestions"
                            android:maxLength="66"
                            android:textSize="13dp"
                            android:textColor="@color/colorCommon6"
                            android:textColorHint="@color/colorMutedSecondaryText"
                            android:background="@drawable/text_input_selector"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textView_pools_tokenB_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="14dp"
                            android:textColor="@color/colorCommon3" />

                        <Button
                            android:id="@+id/spinner_pools_tokenB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="40dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:gravity="start|center_vertical"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textColor="@color/colorWhite"
                            android:drawableEnd="@drawable/caret_down_outline"
                            android:background="@drawable/token_picker_trigger_bg" />

                        <EditText
                            android:id="@+id/editText_pools_tokenB_custom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="0x..."
                            android:inputType="textNoSuggestions"
                            android:maxLength="66"
                            android:textSize="13dp"
                            android:textColor="@color/colorCommon6"
                            android:textColorHint="@color/colorMutedSecondaryText"
                            android:background="@drawable/text_input_selector"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/textView_pools_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textSize="13dp"
                            android:textColor="@color/quantumAmber"
                            android:visibility="gone" />

                        <!-- Desktop #divCreatePairGasIcon: fee label + gas pump. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView_pools_gas_fee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:textSize="12sp"
                                android:textColor="#B3FFFFFF" />

                            <ImageView
                                android:id="@+id/imageView_pools_gas_icon"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="Gas"
                                android:src="@drawable/gas_icon_selector" />

                        <Button
                            android:id="@+id/button_pools_create"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textAllCaps="false"
                            android:textColor="@color/colorWhite"
                            android:background="@drawable/button_green_selector" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>
