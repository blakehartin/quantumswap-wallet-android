<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/body_ambient"
        android:orientation= "vertical">

        <LinearLayout
            android:id="@+id/top_linear_layout_home_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/header_band"
            android:paddingBottom="12dp"
            android:orientation="vertical">
            <!-- Brand row, mirroring the desktop header (styles.css
                 .gradient/.logoimg + theme-quantum.css .animate-character):
                 34dp transparent mark beside the wordmark on one line. The
                 wordmark's white -> violet -> cyan gradient fill is applied
                 in HomeActivity (text shaders aren't expressible in XML). -->
            <LinearLayout
                android:id="@+id/linearLayout_home_brand_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imageView_home_logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/logo_mark" />
                <TextView
                    android:id="@+id/textView_home_tile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/colorCommon6"
                    android:textSize="21sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/textView_home_load_seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:textColor="@color/colorCommon6"
                android:textSize="16dp"
                android:textAlignment="center"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linerLayout_home_offline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/top_linear_layout_home_id"
            android:layout_alignParentBottom="true"
            android:background="@color/colorGainsboro"
            android:gravity="center_vertical|center_horizontal"
            android:paddingTop="150dp"
            android:visibility="gone">
                <include layout="@layout/retry_layout"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/center_relative_layout_home_id"
            android:layout_alignParentBottom="true"
            android:background="@android:color/transparent"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/frame_home_container_id"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- Desktop parity: on home the band grows (168px) and the main
             card is pulled up over it (main-content margin-top -100px).
             Here: the band gets extra bottom padding on home (see
             HomeActivity.screenViewType) and the card overlaps it via a
             negative top margin. Declared after the band so it paints
             on top. -->
        <RelativeLayout
            android:id="@+id/center_relative_layout_home_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/top_linear_layout_home_id"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-56dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/center_container">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <!-- Desktop .text-wallet-address: monospace, body text
                         color #e0e0e6, regular weight. -->
                    <TextView
                        android:id="@+id/textView_home_wallet_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textColor="@color/colorCommon6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/imageButton_home_copy_clipboard"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:layout_gravity="center_vertical|left"
                            android:background="@drawable/image_selector"
                            android:src="@drawable/copy_outline"
                            app:tint="@color/colorCommon6" />

                        <TextView
                            android:id="@+id/textView_home_copied"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/colorCommon6"
                            android:textSize="14dp"
                            android:visibility="gone"
                            android:layout_marginStart="4dp" />

                        <ImageButton
                            android:id="@+id/imageButton_home_block_explore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:layout_gravity="center_vertical|left"
                            android:background="@drawable/image_selector"
                            android:src="@drawable/address_explore"
                            app:tint="@color/colorCommon6" />

                        <ImageButton
                            android:id="@+id/imageButton_home_refresh"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|left"
                            android:padding="5dp"
                            android:scaleType="fitCenter"
                            android:background="@drawable/image_selector"
                            android:src="@drawable/retry"
                            app:tint="@color/colorCommon6" />

                        <ProgressBar
                            android:id="@+id/progress_home_loader"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|left"
                            android:padding="5dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:max="100"
                            android:progress="0"
                            android:background="@android:color/transparent"
                            android:indeterminateDrawable="@drawable/progress" />

                    </LinearLayout>



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView_home_coin_symbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="5dp"
                            android:textColor="@color/colorCommon6"
                            android:textSize="24dp"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <!--
                            Default text is "-" (NOT "0"). The view starts
                            empty conceptually; "0" would be a misleading
                            authoritative claim that the wallet has no
                            funds before the balance fetch has even
                            returned. The "-" placeholder also matches the
                            seed-confirmation balance row in
                            home_wallet_fragment.xml so all three
                            balance-display surfaces (main / send / seed
                            confirm) read the same way before data lands.
                        -->
                        <TextView
                            android:id="@+id/textView_home_balance_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="5dp"
                            android:text="-"
                            android:textStyle="bold"
                            android:textSize="18dp"
                            android:textColor="@color/quantumGreen" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:alpha="0.08"
                        android:background="@drawable/line_2_shape" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal|center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Desktop-parity action tiles (theme-quantum-chrome.css
                                 .buttons-container .button): translucent glass in the
                                 tile hue - 14% fill, 60% 1dp border, 10dp radius,
                                 white icon. Send=amber #F59E0B, Receive=emerald
                                 #10B981, Transactions=blue #3B82F6, Swap=magenta
                                 #D946EF. -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#24F59E0B"
                                app:strokeColor="#99F59E0B"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_send"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="13dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:background="@drawable/tile_press_overlay"
                                    android:src="@drawable/arrow_up"
                                    app:tint="@color/colorWhite" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/textView_home_send_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#2410B981"
                                app:strokeColor="#9910B981"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_receive"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="15dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/tile_press_overlay"
                                    android:src="@drawable/arrow_down_outline"
                                    app:tint="@color/colorWhite" />


                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/textView_home_receive_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#243B82F6"
                                app:strokeColor="#993B82F6"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_transactions"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="15dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/tile_press_overlay"
                                    android:src="@drawable/document"
                                    app:tint="@color/colorWhite" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/textView_home_transactions_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="55dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center_horizontal"
                                app:cardBackgroundColor="#24D946EF"
                                app:strokeColor="#99D946EF"
                                app:strokeWidth="1dp"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <ImageButton
                                    android:id="@+id/imageButton_home_swap"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:padding="15dp"
                                    android:layout_gravity="center_vertical|left"
                                    android:layout_centerInParent="true"
                                    android:background="@drawable/tile_press_overlay"
                                    android:src="@drawable/swap_horizontal"
                                    app:tint="@color/colorWhite" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/textView_home_swap_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/transaction_list_headings"
                                android:textColor="@color/colorCommon6" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

        <!-- Desktop .dropdown network chip: glass pill, 12sp bold,
             wide letter-spacing, floats over the band's top-right. -->
        <TextView
            android:id="@+id/textView_home_blockchain_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:background="@drawable/chip_network"
            android:drawableRight="@drawable/caret_down_outline"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:textColor="@drawable/chip_network_text"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Desktop .burger-button: 36dp glass square, three white bars,
             opens the navigation drawer (replaces the bottom nav). -->
        <ImageButton
            android:id="@+id/imageButton_home_burger"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/burger_button_bg"
            android:src="@drawable/ic_burger"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@string/nav_wallets_title"
            android:visibility="gone" />

    </RelativeLayout>

    <!-- Desktop .burger-dropdown as an Android navigation drawer:
         panel #0b0b12 with hairline border, white-82% items. -->
    <LinearLayout
        android:id="@+id/linearLayout_home_drawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/quantumPanel"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/linearLayout_drawer_wallets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/drawer_item_bg">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_wallet_outline"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/textView_drawer_wallets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="15sp"
                android:textColor="#D1FFFFFF"
                android:text="@string/nav_wallets_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout_drawer_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/drawer_item_bg">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/m_settings"
                android:importantForAccessibility="no"
                app:tint="@color/colorWhite" />
            <TextView
                android:id="@+id/textView_drawer_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="15sp"
                android:textColor="#D1FFFFFF"
                android:text="@string/nav_settings_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout_drawer_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/drawer_item_bg">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_keypad"
                android:importantForAccessibility="no"
                app:tint="@color/colorWhite" />
            <TextView
                android:id="@+id/textView_drawer_advanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="15sp"
                android:textColor="#D1FFFFFF"
                android:text="@string/nav_advanced_title" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>