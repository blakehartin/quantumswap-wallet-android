<?xml version="1.0" encoding="utf-8"?>

<!--
    Create Token screen (desktop tokenCreateScreen, screens/advanced.ts):
    Token Name (max 48), Token Symbol (max 16), Decimals 1-18 (default
    18), Total Supply, inline validation error, and a right-aligned
    Create button. Deploys the CreatedToken ERC-20 through the bridge's
    tokensSubmitCreate; progress runs in the shared TxStepsDialog.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/top_linear_layout_token_create_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@android:color/transparent">
                <ImageButton
                    android:id="@+id/imageButton_token_create_back_arrow"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:layout_gravity="left"
                    android:background="@drawable/image_selector"
                    android:src="@drawable/arrow_back_circle_outline"
                    app:tint="@color/colorCommon6"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_below="@+id/top_linear_layout_token_create_id"
                android:background="@drawable/center_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView_token_create_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="5dp"
                        android:gravity="center"
                        android:textSize="20dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon6" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.2"
                        android:background="@drawable/line_2_shape" />

                    <TextView
                        android:id="@+id/textView_token_create_name_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon1" />

                    <EditText
                        android:id="@+id/editText_token_create_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:inputType="text"
                        android:maxLength="48"
                        android:textSize="15dp"
                        android:textColor="@color/colorCommon6"
                        android:textColorHint="@color/colorMutedSecondaryText"
                        android:background="@drawable/text_input_selector" />

                    <TextView
                        android:id="@+id/textView_token_create_symbol_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon1" />

                    <EditText
                        android:id="@+id/editText_token_create_symbol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:inputType="textNoSuggestions"
                        android:maxLength="16"
                        android:textSize="15dp"
                        android:textColor="@color/colorCommon6"
                        android:textColorHint="@color/colorMutedSecondaryText"
                        android:background="@drawable/text_input_selector" />

                    <TextView
                        android:id="@+id/textView_token_create_decimals_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon1" />

                    <Spinner
                        android:id="@+id/spinner_token_create_decimals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="44dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="32dp"
                        android:background="@drawable/spinner_dropdown_background" />

                    <TextView
                        android:id="@+id/textView_token_create_supply_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorCommon1" />

                    <EditText
                        android:id="@+id/editText_token_create_supply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:inputType="numberDecimal"
                        android:maxLength="40"
                        android:textSize="15dp"
                        android:textColor="@color/colorCommon6"
                        android:textColorHint="@color/colorMutedSecondaryText"
                        android:background="@drawable/text_input_selector" />

                    <!-- Desktop divCreateTokenError (.tx-steps-error). -->
                    <TextView
                        android:id="@+id/textView_token_create_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="13dp"
                        android:textColor="#DC2626"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/progress_token_create"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_margin="4dp"
                            android:indeterminate="true"
                            android:indeterminateDrawable="@drawable/progress"
                            android:visibility="gone" />

                        <!-- Desktop #divCreateTokenGasIcon: fee label + gas pump. -->
                        <TextView
                            android:id="@+id/textView_token_create_gas_fee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:textSize="12sp"
                            android:textColor="#B3FFFFFF" />

                        <ImageView
                            android:id="@+id/imageView_token_create_gas_icon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Gas"
                            android:src="@drawable/gas_icon_selector" />

                        <Button
                            android:id="@+id/button_token_create"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:paddingLeft="20dp"
                            android:paddingRight="20dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textAllCaps="false"
                            android:textColor="@color/colorWhite"
                            android:background="@drawable/button_green_selector" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>
