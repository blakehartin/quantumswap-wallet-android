<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop token picker (modals.ts buildTokenPickerDialog +
     overrides.css .token-picker-*): flat #17151f panel, search box
     that doubles as custom-contract input, optional "Show
     unrecognized tokens" checkbox, status line, flat row list.
     Populated by TokenPickerController. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/token_picker_dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView_token_picker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/colorWhite" />

        <TextView
            android:id="@+id/textView_token_picker_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="×"
            android:textSize="25sp"
            android:textColor="@color/colorWhite"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/drawer_item_bg" />

    </LinearLayout>

    <EditText
        android:id="@+id/editText_token_picker_search"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="15dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textNoSuggestions"
        android:maxLength="66"
        android:textSize="14sp"
        android:textColor="@color/colorWhite"
        android:textColorHint="@color/colorMutedSecondaryText"
        android:background="@drawable/token_picker_search_bg" />

    <CheckBox
        android:id="@+id/checkBox_token_picker_unrecognized"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textColor="#DDD8E9"
        android:buttonTint="#8C71FF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textView_token_picker_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="3dp"
        android:minHeight="18dp"
        android:textSize="12sp"
        android:textColor="#C7C1D9" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF" />

    <ScrollView
        android:id="@+id/scrollView_token_picker_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/linearLayout_token_picker_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
