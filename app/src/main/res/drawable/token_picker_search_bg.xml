<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop input.token-picker-search: white 8% fill, white 28% 1px
     border, 8px radius; focus turns the border violet #8C71FF. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#FF8C71FF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
