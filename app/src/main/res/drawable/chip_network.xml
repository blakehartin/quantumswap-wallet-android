<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop network chip (.dropdown): input-bg glass pill with a
     white hairline border; hover/press lightens to white 8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#21FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D908080E" />
            <stroke android:width="1dp" android:color="#21FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
