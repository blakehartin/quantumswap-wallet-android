<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop .swap-flip button: 40px circle, dark navy #1C1F2F fill,
     1px border rgb(145,125,207) @ 60%; hover lightens to #2A2E46 with
     a brighter border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF2A2E46" />
            <stroke android:width="1dp" android:color="#FFA594DC" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF1C1F2F" />
            <stroke android:width="1dp" android:color="#99917DCF" />
        </shape>
    </item>
</selector>
