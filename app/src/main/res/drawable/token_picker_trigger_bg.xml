<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop .token-picker-trigger (overrides.css): frosted glass -
     white 10% fill, white 30% 1px border, 7px radius; hover/focus
     lightens to 15% and the border goes violet #8C71FF. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#FF8C71FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#FF8C71FF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
