<?xml version="1.0" encoding="utf-8"?>
<!-- Desktop .burger-button: glass (white 4%) with input-border
     hairline, 9dp radius; hover/press lightens to white 8%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#21FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#21FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
